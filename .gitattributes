# Normalize text files while preserving Windows scripts.
* text=auto

*.go       text eol=lf
*.mod      text eol=lf
*.sum      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Binary files
*.exe      binary
*.dll      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.zip      binary
*.pdf      binary
